# Application Port
PORT=3000

# Node Environment (development / staging / production)
NODE_ENV=development

# MongoDB Connection String & Database Name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bathroom

# Web origin (no trailing slash); HTTPS required outside local development.
APP_ORIGIN=http://127.0.0.1:5173

# Vite also reads this root env file. APP_ORIGIN supplies its allowed hostname.
# Optional development proxy override; otherwise uses http://127.0.0.1:<PORT>.
API_PROXY_TARGET=
# Public identifier only. Never put secrets in VITE_* variables.
VITE_LIFF_ID=

# LINE Login credentials (different from Messaging API credentials).
# Required in production; missing development values disable login only.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_PROVIDER_ID=

# Optional: a distinct LIFF/MINI App channel under the SAME provider.
# When set to a different channel, LINE_LIFF_PROVIDER_ID must equal LINE_PROVIDER_ID.
LINE_LIFF_CHANNEL_ID=
LINE_LIFF_PROVIDER_ID=

# Legacy optional JWT verification only; never used for protected writes.
JWT_SECRET=

# Custom DNS Servers (Optional)
DNS_SERVERS=1.1.1.1,8.8.8.8

# LINE Messaging API Credentials
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# Google Maps Static API
GOOGLE_MAPS_STATIC_API_KEY=
